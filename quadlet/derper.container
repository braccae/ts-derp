[Unit]
Description=Tailscale Custom DERP Relay Container
After=tailscaled.service derp-pod.service

[Container]
ContainerName=derper
Image=ghcr.io/braccae/ts-derp:latest
Pod=derp.pod

# Persistent named volume for Let's Encrypt / ACME certificates
Volume=derper-certs:/certs
# Note: /var/run/tailscale is automatically inherited from derp.pod

# Flags: Uses shared /var/run/tailscale/tailscaled.sock inherited from derp.pod
Exec=--hostname=derp.yourdomain.com --certdir=/certs --certmode=letsencrypt --verify-clients=true -a=:443 -http-port=80 -stun=true

[Install]
WantedBy=default.target
