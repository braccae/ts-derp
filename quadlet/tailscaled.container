[Unit]
Description=Tailscale Daemon Container (Client Verification for DERP)
After=derp-pod.service

[Container]
ContainerName=tailscaled
Image=docker.io/tailscale/tailscale:latest
Pod=derp.pod

# Run in userspace networking mode (no /dev/net/tun needed)
Environment=TS_USERSPACE=true
Environment=TS_AUTH_ONCE=true
Environment=TS_STATE_DIR=/var/lib/tailscale

# Replace with an auth key from your Tailscale admin console (ephemeral or reusable)
Environment=TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxxx

# Named volume for persistent state across restarts
Volume=tailscale-state:/var/lib/tailscale
# Note: /var/run/tailscale is automatically inherited from derp.pod

[Install]
WantedBy=default.target
